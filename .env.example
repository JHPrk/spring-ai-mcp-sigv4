# MCP Gateway live IT environment (example)

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=ap-northeast-2

MCP_GW_URL=
MCP_GW_ENDPOINT=/mcp
MCP_IAM_AUTH_SERVICE=bedrock-agentcore

