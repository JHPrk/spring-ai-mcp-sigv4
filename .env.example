# MCP Gateway live IT environment (example)

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=ap-northeast-2

MCP_GW_URL=
MCP_GW_ENDPOINT=/mcp
MCP_IAM_AUTH_SERVICE=bedrock-agentcore

# Required whenever MCP_GW_URL enables live verification.
MCP_IAM_IT_TOOL_NAME=
MCP_IAM_IT_TOOL_ARGUMENTS_JSON={}

# Starter IT requires AWS_REGION and an echo tool accepting a message string.
# Optional assertions; prefer -PagentCoreItTracing=true to attach the test-only agent.
MCP_IAM_IT_TRACING=false
MCP_IAM_IT_EXPECTED_RESULT_JSON=
